MONGO_URL=mongodb+srv://USERNAME:PASSWORD@CLUSTER/frext?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
# Temporarily enable only while creating your initial trusted accounts.
ALLOW_SIGNUP=false

